  .sb-progress .label{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;}
  .prog-bar{background:rgba(255,255,255,0.1);border-radius:4px;height:5px;overflow:hidden;}
  .prog-fill{background:linear-gradient(90deg,var(--teal),var(--gold));height:100%;width:0%;transition:width .5s;}
  .prog-text{font-size:11px;color:#8090a8;margin-top:5px;}

  /* ─── MAIN ─── */
  #main{margin-left:var(--sidebar-w);flex:1;padding:0;}
  .page{display:none;animation:fadeIn .35s ease;}
  .page.active{display:block;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

  /* ─── TOP BANNER ─── */
  .hero{
    background:linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 55%,#162a52 100%);
    padding:52px 52px 44px;position:relative;overflow:hidden;
  }
  .hero::before{
    content:'';position:absolute;top:-60px;right:-80px;
    width:340px;height:340px;
    border:1px solid rgba(201,152,58,0.15);border-radius:50%;
  }
  .hero::after{
    content:'';position:absolute;top:20px;right:40px;
    width:180px;height:180px;
    border:1px solid rgba(30,138,124,0.2);border-radius:50%;
  }
  .hero .part-badge{
    display:inline-block;background:rgba(201,152,58,0.15);
    border:1px solid rgba(201,152,58,0.3);
    color:var(--gold-light);font-size:11px;letter-spacing:2px;text-transform:uppercase;
    padding:5px 14px;border-radius:20px;margin-bottom:16px;
  }
  .hero h2{font-family:'Playfair Display',serif;font-size:36px;color:#fff;line-height:1.2;max-width:620px;margin-bottom:12px;}
  .hero p{font-size:15px;color:#8fa3c8;max-width:580px;line-height:1.6;}
  .hero .meta{display:flex;gap:24px;margin-top:24px;flex-wrap:wrap;}
  .hero .meta span{font-size:12px;color:#6080a8;display:flex;align-items:center;gap:6px;}
  .hero .meta span::before{content:'•';color:var(--teal);}

  /* ─── CONTENT AREA ─── */
  .content-wrap{padding:44px 52px 60px;}

  /* ─── SECTION HEADERS ─── */
  .sec-title{
    font-family:'Playfair Display',serif;font-size:26px;color:var(--navy);
    margin-bottom:8px;padding-bottom:12px;
    border-bottom:2px solid var(--gold);display:inline-block;
  }
  .sec-sub{font-size:14px;color:var(--text-light);margin-bottom:28px;line-height:1.6;}

  /* ─── CALLOUT BOXES ─── */
  .callout{border-radius:10px;padding:18px 22px;margin:20px 0;display:flex;gap:14px;align-items:flex-start;}
  .callout-icon{font-size:22px;flex-shrink:0;margin-top:1px;}
  .callout-body h4{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;}
  .callout-body p{font-size:14px;line-height:1.6;}
  .callout.info{background:var(--teal-pale);border-left:4px solid var(--teal);}
  .callout.info .callout-body h4{color:var(--teal);}
  .callout.warn{background:var(--amber-pale);border-left:4px solid var(--amber);}
  .callout.warn .callout-body h4{color:var(--amber);}
  .callout.danger{background:var(--red-pale);border-left:4px solid var(--red);}
  .callout.danger .callout-body h4{color:var(--red);}
  .callout.success{background:var(--green-pale);border-left:4px solid var(--green);}
  .callout.success .callout-body h4{color:var(--green);}
  .callout.gold{background:#fdf5e0;border-left:4px solid var(--gold);}
  .callout.gold .callout-body h4{color:#9a6e0f;}

  /* ─── STATS ROW ─── */
  .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:24px 0;}
  .stat-card{
    background:#fff;border-radius:12px;padding:22px 18px;
    border:1px solid var(--border);text-align:center;
    box-shadow:0 2px 8px rgba(15,31,61,0.05);
  }
  .stat-card .val{font-family:'Playfair Display',serif;font-size:30px;color:var(--navy);font-weight:700;}
  .stat-card .lbl{font-size:11px;color:var(--text-light);margin-top:5px;line-height:1.4;}

  /* ─── CARDS GRID ─── */
  .cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin:24px 0;}
  .card{background:#fff;border-radius:12px;padding:24px;border:1px solid var(--border);box-shadow:0 2px 10px rgba(15,31,61,0.06);}
  .card .card-badge{
    display:inline-block;padding:3px 10px;border-radius:12px;
    font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
    margin-bottom:12px;
  }
  .card.perm .card-badge{background:#e3f0ff;color:#1a5aad;}
  .card.contract .card-badge{background:#fff0db;color:#b56a00;}
  .card.c2h .card-badge{background:#e8f7ef;color:#1a7a4a;}
  .card h3{font-family:'Playfair Display',serif;font-size:18px;color:var(--navy);margin-bottom:8px;}
  .card p{font-size:13.5px;color:var(--text-mid);line-height:1.6;margin-bottom:12px;}
  .card ul{list-style:none;padding:0;}
  .card ul li{font-size:13px;color:var(--text-mid);padding:4px 0 4px 18px;position:relative;line-height:1.5;}
  .card ul li::before{content:'→';position:absolute;left:0;color:var(--teal);font-size:11px;top:5px;}
  .card .pitch{
    background:var(--teal-pale);border-radius:8px;padding:12px 14px;
    margin-top:14px;font-size:13px;color:#155f54;font-style:italic;line-height:1.5;
  }
  .card .pitch::before{content:'💬 Say: ';font-style:normal;font-weight:600;}

  /* ─── COMPARISON TABLE ─── */
  .comp-table{width:100%;border-collapse:collapse;margin:20px 0;font-size:13.5px;}
  .comp-table th{background:var(--navy);color:#fff;padding:12px 14px;text-align:left;font-weight:600;font-size:12px;letter-spacing:.4px;}
  .comp-table th:first-child{border-radius:8px 0 0 0;}
  .comp-table th:last-child{border-radius:0 8px 0 0;}
  .comp-table td{padding:11px 14px;border-bottom:1px solid var(--border);vertical-align:top;}
  .comp-table tr:nth-child(even) td{background:rgba(15,31,61,0.025);}
  .comp-table tr:last-child td:first-child{border-radius:0 0 0 8px;}
  .comp-table tr:last-child td:last-child{border-radius:0 0 8px 0;}
  .comp-table .good{color:var(--green);font-weight:600;}
  .comp-table .warn{color:var(--amber);font-weight:600;}
  .comp-table .bad{color:var(--red);font-weight:600;}

  /* ─── MATRIX TABLE ─── */
  .matrix-wrap{overflow-x:auto;margin:20px 0;}
  .matrix-table{width:100%;border-collapse:collapse;font-size:12.5px;min-width:680px;}
  .matrix-table th{background:var(--navy-mid);color:#fff;padding:10px 12px;text-align:center;font-size:11px;letter-spacing:.4px;}
  .matrix-table th:first-child{text-align:left;}
  .matrix-table td{padding:9px 12px;border-bottom:1px solid var(--border);vertical-align:middle;}
  .matrix-table td:not(:first-child){text-align:center;}
  .matrix-table tr:nth-child(even) td{background:rgba(15,31,61,0.025);}
  .matrix-table .auth-name{font-weight:600;color:var(--navy);}
  .badge-accept{display:inline-block;background:#e8f7ef;color:var(--green);border:1px solid #b8dfc8;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;}
  .badge-decline{display:inline-block;background:var(--red-pale);color:var(--red);border:1px solid #f1b8b2;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;}
  .badge-check{display:inline-block;background:var(--amber-pale);color:var(--amber);border:1px solid #f5c888;border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;}

  /* ─── TIMELINE / FLOW ─── */
  .flow-row{display:flex;align-items:center;gap:0;margin:24px 0;flex-wrap:wrap;}
  .flow-step{
    background:#fff;border:1px solid var(--border);border-radius:10px;
    padding:16px 18px;flex:1;min-width:160px;
    box-shadow:0 2px 6px rgba(15,31,61,0.06);
  }
  .flow-step .step-num{font-size:10px;color:var(--teal);font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;}
  .flow-step h4{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:5px;}
  .flow-step p{font-size:12px;color:var(--text-light);line-height:1.5;}
  .flow-arrow{font-size:22px;color:var(--gold);padding:0 8px;flex-shrink:0;}

  /* ─── VISA CARDS ─── */
  .visa-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin:24px 0;}
  .visa-card{background:#fff;border-radius:12px;padding:24px;border:1px solid var(--border);border-top:4px solid var(--navy);}
  .visa-card.f1{border-top-color:#3a7bd5;}
  .visa-card.h1b{border-top-color:#c0392b;}
  .visa-card.gc{border-top-color:var(--green);}
  .visa-card.ead{border-top-color:var(--teal);}
  .visa-card.tn{border-top-color:var(--gold);}
  .visa-card.l1{border-top-color:#7b52ab;}
  .visa-card.o1{border-top-color:#e67e22;}
  .visa-card .vc-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;}
  .visa-card h3{font-family:'Playfair Display',serif;font-size:18px;color:var(--navy);}
  .visa-card .vc-code{font-family:'Source Code Pro',monospace;font-size:22px;color:var(--border);font-weight:500;}
  .visa-card .vc-row{display:flex;gap:8px;align-items:flex-start;margin:7px 0;font-size:13px;}
  .visa-card .vc-label{color:var(--text-light);min-width:100px;flex-shrink:0;font-weight:500;}
  .visa-card .vc-val{color:var(--text-dark);line-height:1.5;}
  .visa-card .vc-tip{
    margin-top:14px;background:#f8f4ff;border-left:3px solid #7b52ab;
    padding:10px 12px;border-radius:0 6px 6px 0;font-size:12.5px;color:#4a3065;line-height:1.5;
  }
  .visa-card.gc .vc-tip{background:var(--green-pale);border-left-color:var(--green);color:#1a4530;}
  .visa-card.h1b .vc-tip{background:var(--red-pale);border-left-color:var(--red);color:#6a1a14;}
  .visa-card.tn .vc-tip{background:#fdf5e0;border-left-color:var(--gold);color:#6a4810;}
  .visa-card.ead .vc-tip{background:var(--teal-pale);border-left-color:var(--teal);color:#0d4a42;}

  /* ─── SCENARIO CARDS ─── */
  .scenario{background:#fff;border-radius:12px;margin:20px 0;overflow:hidden;border:1px solid var(--border);box-shadow:0 2px 10px rgba(15,31,61,0.07);}
  .scenario-header{padding:16px 22px;display:flex;align-items:center;gap:12px;}
  .scenario.opta .scenario-header{background:linear-gradient(135deg,#1a3875,#243d78);}
  .scenario.h1bscen .scenario-header{background:linear-gradient(135deg,#7a1a14,#9c251e);}
  .scenario.gcscen .scenario-header{background:linear-gradient(135deg,#1a5a35,#1a7a4a);}
  .scenario-header .scen-badge{font-family:'Source Code Pro',monospace;font-size:26px;color:rgba(255,255,255,0.2);font-weight:700;margin-left:auto;}
  .scenario-header h3{font-family:'Playfair Display',serif;font-size:18px;color:#fff;}
  .scenario-header p{font-size:13px;color:rgba(255,255,255,0.7);}
  .scenario-body{padding:22px 24px;}
  .ask-block{margin-bottom:16px;}
  .ask-block h4{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--teal);margin-bottom:10px;}
  .ask-block ul{list-style:none;padding:0;}
  .ask-block ul li{
    font-size:13.5px;color:var(--text-mid);padding:7px 0 7px 22px;
    position:relative;border-bottom:1px solid var(--border);
    font-family:'Source Code Pro',monospace;
  }
  .ask-block ul li:last-child{border-bottom:none;}
  .ask-block ul li::before{content:'"';position:absolute;left:0;color:var(--teal);font-size:18px;top:4px;font-family:serif;}
  .say-block{background:var(--green-pale);border-radius:8px;padding:14px 18px;font-size:13.5px;color:#1a4530;font-style:italic;line-height:1.6;margin-bottom:14px;}
  .say-block::before{content:'Say: ';font-style:normal;font-weight:700;color:var(--green);}
  .flag-block{background:var(--red-pale);border-radius:8px;padding:12px 16px;font-size:13px;color:#7a2a22;margin-top:8px;}
  .flag-block::before{content:'🚩 Red Flag: ';font-weight:700;}
  .action-block{background:var(--amber-pale);border-radius:8px;padding:12px 16px;font-size:13px;color:#7a4a10;margin-top:8px;}
  .action-block::before{content:'→ Action: ';font-weight:700;}

  /* ─── MISTAKES LIST ─── */
  .mistakes-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0;}
  .mistake{background:#fff;border-radius:10px;padding:20px;border:1px solid var(--border);border-left:4px solid var(--red);}
  .mistake .m-num{font-family:'Playfair Display',serif;font-size:36px;color:rgba(192,57,43,0.15);font-weight:700;float:right;margin-top:-6px;}
  .mistake h4{font-size:14px;font-weight:700;color:var(--red);margin-bottom:8px;}
  .mistake p{font-size:13px;color:var(--text-mid);line-height:1.6;}
  .mistake .fix{margin-top:10px;font-size:12.5px;color:var(--green);font-weight:600;}
  .mistake .fix::before{content:'✓ Fix: ';}

  /* ─── TZ TABLE ─── */
  .tz-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0;}
  .tz-card{background:#fff;border-radius:10px;padding:16px;border:1px solid var(--border);text-align:center;}
  .tz-card .zone{font-size:22px;font-weight:700;font-family:'Playfair Display',serif;color:var(--navy);margin-bottom:4px;}
  .tz-card .tz-name{font-size:11px;color:var(--text-light);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;}
  .tz-card .states{font-size:11.5px;color:var(--text-mid);margin-bottom:8px;line-height:1.6;}
  .tz-card .ist{font-size:12px;color:var(--teal);font-weight:600;}

  /* ─── TAKEAWAYS ─── */
  .takeaways-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0;}
  .takeaway{background:#fff;border-radius:12px;padding:22px;border:1px solid var(--border);display:flex;gap:16px;}
  .takeaway .t-num{
    width:36px;height:36px;background:var(--navy);color:#fff;
    border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-family:'Playfair Display',serif;font-size:16px;font-weight:700;flex-shrink:0;
  }
  .takeaway h4{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:6px;}
  .takeaway p{font-size:13px;color:var(--text-mid);line-height:1.6;}

  /* ─── QUIZ ─── */
  .quiz-wrap{margin:24px 0;}
  .q-card{background:#fff;border-radius:12px;padding:24px;border:1px solid var(--border);margin-bottom:16px;}
  .q-card h4{font-size:15px;font-weight:600;color:var(--navy);margin-bottom:16px;line-height:1.5;}
  .q-card .q-num{font-size:10px;color:var(--teal);font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
  .options{display:flex;flex-direction:column;gap:8px;}
  .opt{
    padding:11px 16px;border-radius:8px;border:1.5px solid var(--border);
    cursor:pointer;font-size:13.5px;color:var(--text-mid);
    transition:all .2s;background:#fff;
  }
  .opt:hover{border-color:var(--teal);color:var(--teal);background:var(--teal-pale);}
  .opt.correct{background:var(--green-pale)!important;border-color:var(--green)!important;color:var(--green)!important;font-weight:600;}
  .opt.wrong{background:var(--red-pale)!important;border-color:var(--red)!important;color:var(--red)!important;}
  .q-feedback{margin-top:12px;padding:12px 16px;border-radius:8px;font-size:13.5px;display:none;line-height:1.6;}
  .q-feedback.show{display:block;}
  .q-feedback.ok{background:var(--green-pale);color:var(--green);}
  .q-feedback.no{background:var(--red-pale);color:var(--red);}
  .quiz-score{background:var(--navy);color:#fff;border-radius:12px;padding:24px;text-align:center;display:none;}
  .quiz-score .score-val{font-family:'Playfair Display',serif;font-size:52px;color:var(--gold);}
  .quiz-score p{font-size:14px;color:#8fa3c8;margin-top:6px;}
  #quiz-btn{
