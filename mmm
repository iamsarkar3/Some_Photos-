<script>
const PAGES = ['intro','usa','jobtypes','w2_1099','visa_overview','decision','scenarios','mistakes','quiz','glossary'];
let visited = new Set(['intro']);

function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const pg = document.getElementById('pg-' + id);
  if (pg) { pg.classList.add('active'); pg.scrollIntoView({behavior:'smooth',block:'start'}); }
  document.querySelectorAll('.sb-nav a').forEach(a => {
    a.classList.toggle('active', a.getAttribute('data-page') === id);
  });
  visited.add(id);
  updateProgress();
}

function updateProgress() {
  const total = 6; // main content pages
  const contentPages = ['intro','usa','jobtypes','w2_1099','visa_overview','decision','scenarios'];
  const seen = contentPages.filter(p => visited.has(p)).length;
  const pct = Math.round((seen / contentPages.length) * 100);
  document.getElementById('progFill').style.width = pct + '%';
  document.getElementById('progText').textContent = seen + ' of ' + contentPages.length + ' sections';
}

function switchTab(el, targetId) {
  const parent = el.closest('.content-wrap') || el.parentElement.parentElement;
  parent.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  parent.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  const tc = document.getElementById(targetId);
  if (tc) tc.classList.add('active');
}

// Quiz
const answers = {1:1, 2:2, 3:0, 4:1, 5:3, 6:2, 7:0, 8:1};
const explanations = {
  1: "✓ Correct! W-2 and 1099 are different employment tax classifications. A W-2 only req explicitly excludes 1099 arrangements — you must ask the candidate if they are willing to convert to W-2.",
  2: "✓ Correct! If the EAD expires before the contract ends, the candidate must stop working mid-placement. Always flag to manager before submitting — never submit knowing the expiry won't cover the contract.",
  3: "✓ Correct! A 1099 contractor pays 15.3% in self-employment tax (~$15,300 on $100k) — double the ~7.65% ($7,650) a W-2 employee pays, because the contractor bears both the employer and employee portions.",
  4: "✓ Correct! If the job order says no H-1B transfer, end the call professionally and offer to add them to your database. Never mislead the candidate about a placement that cannot happen on this req.",
  5: "✓ Correct! Standard OPT = 12 months post-graduation. STEM OPT = additional 24 months. Total = 36 months. Confusing these two means either underestimating or overestimating a candidate's available work auth.",
  6: "✓ Correct! Healthcare clients typically require GC or USC only — not just W-2 compatibility. OPT/EAD on W-2 satisfies the W-2 requirement but may fail the GC/USC only requirement. Always read both fields on the job order.",
  7: "✓ Correct! Green Card is the cleanest work auth outcome for a recruiter. No expiry date to track, no employer dependency, no transfer process, no sponsorship required. Any employer, any role, any time.",
  8: "✓ Correct! The correct sequence is: (1) Confirm identity → (2) Brief pitch/interest check → (3) Work auth question → (4) Proceed only if compatible. Asking too early (before any rapport) feels abrupt; asking too late wastes 20 minutes."
};
const wrongMsg = {
  1: "✗ Incorrect. W-2 and 1099 are different employment tax classifications. A W-2 only req explicitly excludes 1099 arrangements regardless of the candidate's preference.",
  2: "✗ Incorrect. If the EAD expires before the contract ends, the candidate must legally stop working mid-placement. This is a compliance risk — flag to manager and do not submit.",
  3: "✗ Incorrect. A 1099 contractor pays 15.3% in self-employment tax on $100k income (~$15,300), because they pay both the employee portion (7.65%) and the employer portion (7.65%) themselves.",
  4: "✗ Incorrect. If the job order says no H-1B transfer, the answer is to end the call professionally and keep the candidate in your database. H-1B compatibility with W-2 is separate from a client's H-1B transfer policy.",
  5: "✗ Incorrect. Standard OPT = 12 months. STEM OPT = 24 month extension = 36 months TOTAL. Distinguishing these two is a mandatory recruiter skill when screening F-1 visa holders.",
  6: "✗ Incorrect. Healthcare clients often require GC or USC only — W-2 compatibility is not sufficient. An OPT EAD candidate on W-2 satisfies the employment type requirement but may fail the separate work auth restriction.",
  7: "✗ Incorrect. While TN and OPT have advantages, Green Card provides the cleanest work auth: no expiry, no employer dependency, no transfer process. It is universally accepted and requires zero compliance tracking.",
  8: "✗ Incorrect. Work auth comes after a brief pitch and interest check — but BEFORE the full skill qualification and pay negotiation. If you qualify for 20 minutes first, then discover the candidate needs H-1B sponsorship, that time is wasted."
};

let score = 0;
let answered = {};

function answerQ(el, isCorrect, qNum) {
  if (answered[qNum]) return;
  answered[qNum] = true;
  const opts = el.parentElement.querySelectorAll('.opt');
  opts.forEach(o => { o.style.pointerEvents = 'none'; });
  const fb = document.getElementById('fb-' + qNum);
  if (isCorrect) {
    el.classList.add('correct');
    fb.textContent = explanations[qNum];
    fb.className = 'q-feedback show ok';
    score++;
  } else {
    el.classList.add('wrong');
    // highlight correct
    const correctIdx = answers[qNum];
    opts[correctIdx].classList.add('correct');
    fb.textContent = wrongMsg[qNum];
    fb.className = 'q-feedback show no';
  }
}

function showScore() {
  const total = 8;
  const sv = document.getElementById('scoreVal');
  const sf = document.getElementById('scoreFeedback');
  sv.textContent = score + '/' + total;
  const pct = Math.round((score / total) * 100);
  let msg = '';
  if (pct === 100) msg = "Perfect score. You are ready for your first live call.";
  else if (pct >= 75) msg = "Strong foundation. Review the questions you missed and re-read the relevant sections.";
  else if (pct >= 50) msg = "Good start. Go back through the Decision Matrix and Screening Scenarios sections before your next session.";
  else msg = "Keep studying. Re-read Part A (W-2 / 1099) and Part B (Visa Overview) before attempting again.";
  sf.textContent = msg;
  document.getElementById('quizScore').style.display = 'block';
  document.getElementById('quiz-btn').style.display = 'none';
}

// Init
updateProgress();
</script>
